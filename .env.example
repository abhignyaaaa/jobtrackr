# Copy to .env for local development. Never commit real values.
APP_ENV=development
DATABASE_URL=postgresql://jt:jt_local_pw@localhost:5432/jobtracker
SECRET_KEY=change-me-for-local-dev
COOKIE_SECURE=false
DEFAULT_TIMEZONE=Asia/Kolkata

# Document storage: disabled | local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads
# For S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, Supabase S3):
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
